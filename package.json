{
  "name": "tusche",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*",
    "evals"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run test",
    "release:build": "bun scripts/release/build.ts",
    "release:smoke": "bun scripts/release/smoke.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  },
  "patchedDependencies": {
    "@open-pencil/core@0.16.0": "patches/@open-pencil%2Fcore@0.16.0.patch",
    "@open-pencil/dom-css@0.16.0": "patches/@open-pencil%2Fdom-css@0.16.0.patch"
  }
}
