                  "stroke": "$color-line",
                  "strokeWidth": {
                    "top": 1
                  },
                  "children": [
                    {
                      "type": "ref",
                      "id": "RGuzd",
                      "name": "FAQ 1",
                      "ref": "vb1NT",
                      "width": "fill_container",
                      "descendants": {
                        "Q9Adz": {
                          "content": "Do I need to upload my RAW files to edit them?"
                        },
                        "vH9Ik": {
                          "content": "No. Darkroom edits locally in the browser or desktop app and only syncs the small edit recipe. Originals go to the cloud library only if you choose to back them up.",
                          "enabled": true
                        },
                        "Urmhf": {
                          "icon": "minus",
                          "fill": "$color-accent"
                        }
                      }
                    },
                    {
                      "type": "ref",
                      "id": "H1eRQ",
                      "name": "FAQ 2",
                      "ref": "vb1NT",
                      "width": "fill_container",
                      "descendants": {
                        "Q9Adz": {
                          "content": "Can I switch between monthly and yearly billing?"
                        },
                        "vH9Ik": {
                          "content": "Yes, any time from Settings → Billing. Moving to yearly applies the 20% discount immediately and credits what's left of your current month.",
                          "enabled": false
                        },
                        "Urmhf": {
                          "icon": "plus",
                          "fill": "$color-muted"
                        }
                      }
                    },
                    {
                      "type": "ref",
                      "id": "RDyh6",
                      "name": "FAQ 3",
                      "ref": "vb1NT",
                      "width": "fill_container",
                      "descendants": {
                        "Q9Adz": {
                          "content": "What happens to my photos if I downgrade or cancel?"
                        },
                        "vH9Ik": {
                          "content": "Nothing is deleted. Your library becomes read-only above the Free plan's 5 GB, and you can export everything with your edits for 12 months.",
                          "enabled": false
                        },
                        "Urmhf": {
                          "icon": "plus",
                          "fill": "$color-muted"
                        }
                      }
                    },
                    {
                      "type": "ref",
                      "id": "oEONQ",
                      "name": "FAQ 4",
                      "ref": "vb1NT",
                      "width": "fill_container",
                      "descendants": {
                        "Q9Adz": {
                          "content": "How does the 14-day Pro trial work?"
                        },
                        "vH9Ik": {
                          "content": "You get every Pro feature without entering a card. At the end of the trial you choose a plan, or you stay on Free with all your edits intact.",
                          "enabled": false
                        },
                        "Urmhf": {
                          "icon": "plus",
                          "fill": "$color-muted"
                        }
                      }
                    },
                    {
                      "type": "ref",
                      "id": "NY2np",
                      "name": "FAQ 5",
                      "ref": "vb1NT",
                      "width": "fill_container",
                      "descendants": {
                        "Q9Adz": {
                          "content": "Do you offer discounts for students and non-profits?"
                        },
                        "vH9Ik": {
                          "content": "Students and teachers get Pro for $4 a month. Registered non-profits get 50% off Studio — write to us with your registration number.",
                          "enabled": false
                        },
                        "Urmhf": {
                          "icon": "plus",
                          "fill": "$color-muted"
                        }
                      }
                    },
                    {
                      "type": "ref",
                      "id": "RAt17",
                      "name": "FAQ 6",
                      "ref": "vb1NT",
                      "width": "fill_container",
                      "descendants": {
                        "Q9Adz": {
                          "content": "Which payment methods do you accept?"
                        },
                        "vH9Ik": {
                          "content": "All major cards, Apple Pay and Google Pay. Studio plans of 10+ seats can pay yearly by invoice and bank transfer.",
                          "enabled": false
                        },
                        "Urmhf": {
                          "icon": "plus",
                          "fill": "$color-muted"
                        }
                      }
                    }
                  ]
                }
